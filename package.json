{
  "name": "bbo",
  "version": "1.0.0",
  "description": "Bbo — HTML5/CSS3/JS app with SQLite, packaged for Android via Capacitor",
  "main": "index.js",
  "scripts": {
    "start": "npx --yes http-server www -p 5173 -c-1",
    "sync": "cap sync android",
    "setup:android": "bash scripts/setup-android-sdk.sh",
    "build:apk": "cap sync android && cd android && ./gradlew assembleDebug",
    "build:apk:release": "cap sync android && cd android && ./gradlew assembleRelease",
    "clean:android": "cd android && ./gradlew clean",
    "open:android": "cap open android"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yasmimim2023-ui/Bbo.git"
  },
  "keywords": [],
  "author": "",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/yasmimim2023-ui/Bbo/issues"
  },
  "homepage": "https://github.com/yasmimim2023-ui/Bbo#readme",
  "dependencies": {
    "@capacitor-community/sqlite": "^8.1.1",
    "@capacitor/android": "^8.5.0",
    "@capacitor/core": "^8.5.0",
    "jeep-sqlite": "^2.8.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.5.0"
  }
}
